# ── Website (Next.js) ─ copy to .env.local ───────────────────────────────
# Public values only. NEXT_PUBLIC_* variables are shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp support number in international format, no "+" (e.g. 2348031234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000

# NOT used by the website and must NEVER be put here or in Vercel's browser env:
#   SUPABASE_SERVICE_ROLE_KEY, PAYSTACK_SECRET_KEY, MAILGUN_API_KEY
# Those live only in Supabase Edge Function secrets (see supabase/.env.example).
