# ── Mobile app (Expo) ─ copy to .env ─────────────────────────────────────
# Everything here is PUBLIC (bundled into the app). Never put secret keys here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
# Live website URL; Paystack returns here (then hands control back to the app)
EXPO_PUBLIC_SITE_URL=https://your-site.vercel.app
# Google OAuth client IDs (Google Cloud → APIs & Services → Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx-web.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx-ios.apps.googleusercontent.com
# (The Android client ID is NOT needed in code: Google matches the app by package name + SHA-1.)
