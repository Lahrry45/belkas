# ── Supabase Edge Function secrets ── set with:
#   npx supabase secrets set NAME=value --project-ref YOUR-PROJECT-REF
# or Dashboard → Edge Functions → Secrets. Never commit real values.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically.
SITE_URL=https://your-site.vercel.app
PAYSTACK_SECRET_KEY=sk_test_xxx            # sk_live_xxx in production
MAILGUN_API_KEY=xxxxxxxxxxxxxxxx-xxxxxxxx-xxxxxxxx   # domain sending key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM=BELKA'S ENTERPRISE <orders@mg.yourdomain.com>
# MAILGUN_API_BASE=https://api.eu.mailgun.net   # only for EU-region Mailgun domains
# EXTRA_CALLBACK_ORIGINS=https://preview.yourdomain.com  # extra allowed Paystack return origins
